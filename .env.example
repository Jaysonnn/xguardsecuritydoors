# --- Database (AWS RDS PostgreSQL in prod, local Postgres/SQLite in dev) ---
# Never commit the real .env. Rotate credentials if ever exposed.
DATABASE_URL="postgresql://user:password@localhost:5432/xguard?schema=public"

# --- Cloudflare Turnstile (bot protection on the booking form) ---
# Get keys at https://dash.cloudflare.com -> Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="change-me"

# --- Auth (verified-customer review submissions) ---
# Generate with: openssl rand -base64 48
JWT_SECRET="change-me-min-32-chars"

# --- Site ---
NEXT_PUBLIC_SITE_URL="https://xguardsecuritydoors.com.au"
NEXT_PUBLIC_PHONE="0431980897"

# --- Notifications (booking alerts via AWS SES, optional) ---
BOOKING_NOTIFY_EMAIL=""
AWS_REGION="ap-southeast-2"
